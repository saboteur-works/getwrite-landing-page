<section id="features" class="border-b border-brand-rule px-6 py-14">
  <div class="grid grid-cols-1 gap-5 md:grid-cols-[140px_1fr] md:gap-10 items-start">

    <div class="font-mono text-[10px] tracking-[0.2em] text-fg-tertiary uppercase md:pt-1 pb-2 md:pb-0 border-b md:border-b-0 border-brand-rule">
      Features
    </div>

    <div class="max-w-2xl">
      <div class="flex items-baseline border-t border-brand-rule py-[13px]">
        <span class="font-sans text-fg-secondary text-[13px] leading-[1.8]">Local First. Your data lives on your drive, not ours.</span>
      </div>
      <div class="flex items-baseline border-t border-brand-rule py-[13px]">
        <span class="font-sans text-fg-secondary text-[13px] leading-[1.8]">Custom project templates. Build your own or use the ones that ship with it.</span>
      </div>
      <div class="flex items-baseline border-t border-brand-rule py-[13px]">
        <span class="font-sans text-fg-secondary text-[13px] leading-[1.8]">Document revisions track every draft. Switch between them at any time.</span>
      </div>
      <div class="flex items-baseline border-t border-brand-rule py-[13px]">
        <span class="font-sans text-fg-secondary text-[13px] leading-[1.8]">Add metadata to your files. Query your work. </span>
      </div>
      <div class="flex items-baseline border-t border-b border-brand-rule py-[13px]">
        <span class="font-sans text-fg-secondary text-[13px] leading-[1.8]">Export to PDF, HTML, or plain text without installing a plugin.</span>
      </div>
    </div>

  </div>
</section>
