---
// Nav — minimal variant, 52px sticky strip.
//
// Two kinds of link. Section anchors (#mission, #features, #status) only
// resolve on the landing page, so showSections={false} drops them on standalone
// pages — /privacy, /terms, /blog, a post. Site routes (/blog) resolve
// everywhere and render unconditionally: dropping the route on those pages
// would strand the reader with only the mark to get back.
//
// Four links is the ceiling, anchors and routes counted together. This nav is
// at it. saboteur-sites/sections/nav/README.md §Rules 7.
interface Props {
  showSections?: boolean;
}
const { showSections = true } = Astro.props;
---
<nav class="sticky top-0 z-10 bg-brand-black border-b border-brand-rule flex items-center h-[52px] px-6">

  <a href="/" class="flex items-baseline border-l-[3px] border-brand-red pl-3" aria-label="Home">
    <span class="font-display font-bold text-fg-primary text-[17px] tracking-[-0.03em] leading-none">
      <span class="text-fg-tertiary font-normal tracking-[-0.02em]">Get</span>Write
    </span>
  </a>

  <ul class="ml-auto flex items-center gap-5">
    {showSections && (
      <>
        <li>
          <a href="#mission" class="font-mono text-[10px] tracking-[0.14em] text-fg-tertiary hover:text-fg-primary uppercase transition-colors duration-150">
            Mission
          </a>
        </li>
        <li>
          <a href="#features" class="font-mono text-[10px] tracking-[0.14em] text-fg-tertiary hover:text-fg-primary uppercase transition-colors duration-150">
            Features
          </a>
        </li>
        <li>
          <a href="#status" class="font-mono text-[10px] tracking-[0.14em] text-fg-tertiary hover:text-fg-primary uppercase transition-colors duration-150">
            Status
          </a>
        </li>
      </>
    )}
    <li>
      <a href="/blog" class="font-mono text-[10px] tracking-[0.14em] text-fg-tertiary hover:text-fg-primary uppercase transition-colors duration-150">
        Blog
      </a>
    </li>
  </ul>

</nav>
