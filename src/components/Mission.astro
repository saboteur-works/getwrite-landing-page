<section id="mission" class="border-b border-brand-rule px-6 py-14">
  <div class="grid grid-cols-1 gap-5 md:grid-cols-[140px_1fr] md:gap-10 items-start">

    <div class="font-mono text-[10px] tracking-[0.2em] text-fg-tertiary uppercase md:pt-1 pb-2 md:pb-0 border-b md:border-b-0 border-brand-rule">
      Mission
    </div>

    <div>
      <h2 class="font-display font-bold text-fg-primary text-[clamp(24px,5vw,32px)] tracking-[-0.03em] leading-[1.1] mb-3.5">
        Writing without the cloud.
      </h2>

      <p class="font-sans text-fg-secondary text-[13px] leading-[1.8] mb-5 max-w-2xl">
        Most writing tools store your work on someone else's server, behind a subscription, in a format only they can read.
        <em class="not-italic text-fg-primary">We built the opposite.</em>
        GetWrite keeps your files on disk, in open formats, owned by you.
      </p>
    </div>

  </div>
</section>
